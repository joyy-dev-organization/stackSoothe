{
  "name": "stacksoothe-service",
  "version": "0.1.0",
  "description": "Local loopback Node/TypeScript diagnosis service for StackSoothe",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --experimental-strip-types src/server.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:unit": "node --test --experimental-strip-types test/schema.test.ts test/security.test.ts",
    "test:sentry-spike": "node --test --experimental-strip-types test/sentry-spike.test.ts",
    "test:defect": "node --test --experimental-strip-types test/defect-reproducer.test.ts",
    "test:evidence": "node --test --experimental-strip-types test/evidence-runner.test.ts",
    "test:hardening": "node --test --experimental-strip-types test/m4-hardening.test.ts",
    "test:privacy": "node --test --experimental-strip-types test/privacy-wan.test.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sentry/node": "^11.9.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
